# Environment Configuration Template
# Copy this file to .env and set your values

# Set to True for debug mode, False for production
DEBUG=True

# PostgreSQL configuration for docker-compose
POSTGRES_DB=ifdbdev
POSTGRES_USER=ifdbdev
POSTGRES_PASSWORD=ifdb
# MAINTENANCE_USER=бездушный робот
CURATION_NOTIFICATION_EMAIL=your-email@example.com
PLAYABLE_DIR=/path/to/playables
PLAYABLE_BASE_DOMAIN=play.crem.xyz
# CADDY_PORT=8080
# CADDY_ADMIN_URL=http://localhost:2019
